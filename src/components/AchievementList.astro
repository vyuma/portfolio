---
import AchievementCard from './AchievementCard.astro';
import { achievements } from '../data/achievements';

// Group by year
const grouped = achievements.reduce<Record<number, typeof achievements>>((acc, item) => {
  const year = item.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {});

// Years descending, within each year chronological (oldest first)
const years = Object.keys(grouped).map(Number).sort((a, b) => b - a);
for (const year of years) {
  grouped[year].sort((a, b) => a.date.getTime() - b.date.getTime());
}

// Count awards per year
function countAwards(items: typeof achievements) {
  return items.filter(i => i.results).length;
}
---
<div class="achievement-list">
  {years.map(year => {
    const items = grouped[year];
    const awardCount = countAwards(items);
    return (
      <section class="year-section">
        {/* Year marker */}
        <div class="year-marker">
          <div class="year-line" />
          <div class="year-badge">
            <span class="year-number">{year}</span>
            <span class="year-meta">
              {items.length} events{awardCount > 0 && ` / ${awardCount} awards`}
            </span>
          </div>
          <div class="year-line" />
        </div>

        {/* Cards */}
        <div class="year-cards">
          {items.map((item, index) => (
            <AchievementCard achievement={item} delay={index * 50} />
          ))}
        </div>
      </section>
    );
  })}
</div>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
  );

  document.querySelectorAll('.card').forEach((el) => {
    observer.observe(el);
  });
</script>

<style>
  .achievement-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  /* Year section */
  .year-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    width: 100%;
    min-width: 0;
  }

  /* Year marker */
  .year-marker {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .year-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border) 20%,
      var(--color-border) 80%,
      transparent 100%
    );
  }

  .year-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }

  .year-number {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--color-accent), var(--color-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .year-meta {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Cards grid */
  .year-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
    min-width: 0;
    align-items: center;
  }
</style>
