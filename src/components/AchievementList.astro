---
import { achievements } from '../data/achievements';

// Group by year
const grouped = achievements.reduce<Record<number, typeof achievements>>((acc, item) => {
  const year = item.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(item);
  return acc;
}, {});

// Years descending, within each year newest first
const years = Object.keys(grouped).map(Number).sort((a, b) => b - a);
for (const year of years) {
  grouped[year].sort((a, b) => b.date.getTime() - a.date.getTime());
}

function countAwards(items: typeof achievements) {
  return items.filter(i => i.results).length;
}

function fmtDate(d: Date) {
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---
<div class="achievement-list">
  {years.map((year, yearIndex) => {
    const items = grouped[year];
    const awardCount = countAwards(items);
    return (
      <details class="year-section" open={yearIndex === 0}>
        <summary class="year-summary">
          <span class="year-number">{year}</span>
          <span class="year-meta">
            {items.length} events{awardCount > 0 && ` / ${awardCount} awards`}
          </span>
          <svg class="year-chevron" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>

        <ul class="year-rows">
          {items.map(item => (
            <li class="row">
              <time class="row-date">{fmtDate(item.date)}</time>
              <div class="row-main">
                <div class="row-head">
                  <span class="row-title">{item.title}</span>
                  {item.results && <span class="row-result">{item.results}</span>}
                </div>
                {item.description && <p class="row-desc">{item.description}</p>}
                {item.urlDescription.length > 0 && (
                  <div class="row-links">
                    {item.urlDescription.map((label, index) => (
                      <a href={item.url[index]} target="_blank" rel="noopener noreferrer" class="row-link">
                        {label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </details>
    );
  })}
</div>

<style>
  .achievement-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg);
    overflow: hidden;
  }

  /* ===== Year section (collapsible) ===== */
  .year-section + .year-section {
    border-top: 1px solid var(--color-border);
  }

  .year-summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color var(--transition-fast);
  }

  .year-summary::-webkit-details-marker {
    display: none;
  }

  .year-summary:hover {
    background-color: var(--color-surface);
  }

  .year-number {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .year-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex: 1;
  }

  .year-chevron {
    width: 16px;
    height: 16px;
    color: var(--color-text-light);
    align-self: center;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .year-section[open] .year-chevron {
    transform: rotate(180deg);
  }

  /* ===== Rows ===== */
  .year-rows {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-lg) var(--space-sm);
  }

  .row {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-sm) 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .row-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
    flex-shrink: 0;
  }

  .row-main {
    min-width: 0;
    flex: 1;
  }

  .row-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm) var(--space-md);
    flex-wrap: wrap;
  }

  .row-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .row-result {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    line-height: var(--leading-snug);
  }

  .row-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 2px 0 0;
    line-height: var(--leading-normal);
    max-width: none;
  }

  .row-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: 2px;
  }

  .row-link {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .row-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 480px) {
    .year-summary {
      padding: var(--space-md);
    }

    .year-rows {
      padding: 0 var(--space-md) var(--space-sm);
    }

    .row {
      flex-direction: column;
      gap: 2px;
    }

    .row-date {
      padding-top: 0;
    }
  }
</style>
