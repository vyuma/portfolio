---
import { profile } from '../data/profile';
import StatsBar from './StatsBar.astro';
---
<section class="hero">
  <div class="hero-inner">
    <p class="hero-kicker">Portfolio</p>
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-affiliation">{profile.affiliation} / {profile.lab}</p>
    <div class="hero-badges">
      {profile.badges.map(badge => (
        <span class="badge">{badge}</span>
      ))}
    </div>
    <div class="hero-roles">
      {profile.roles.map(role => (
        <span class="role-tag">{role}</span>
      ))}
    </div>
    <p class="hero-bio">{profile.bio}</p>
    <div class="hero-cta">
      <a href="/achievements" class="btn btn-primary">実績を見る</a>
      <a href="/products" class="btn btn-outline">プロダクト</a>
    </div>
  </div>
  <StatsBar />
</section>

<style>
  .hero {
    text-align: center;
    padding: var(--space-3xl) var(--space-md) var(--space-2xl);
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-light);
    margin: 0 0 var(--space-sm);
    max-width: none;
  }

  .hero-name {
    font-size: var(--text-hero);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
    letter-spacing: -0.04em;
  }

  .hero-affiliation {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0 auto var(--space-lg);
    max-width: none;
  }

  .hero-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    white-space: nowrap;
  }

  .badge::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    flex-shrink: 0;
  }

  .hero-roles {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .role-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .role-tag + .role-tag::before {
    content: '·';
    margin-right: var(--space-md);
    color: var(--color-text-light);
  }

  .hero-bio {
    max-width: 560px;
    margin: 0 auto var(--space-xl);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--color-text);
    color: var(--color-bg);
    border: 1px solid var(--color-text);
  }

  .btn-primary:hover {
    opacity: 0.85;
    color: var(--color-bg);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-outline {
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background: transparent;
  }

  .btn-outline:hover {
    border-color: var(--color-text);
    color: var(--color-text);
    text-decoration: none;
    transform: translateY(-1px);
  }
</style>
