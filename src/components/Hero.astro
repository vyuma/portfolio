---
import { profile } from '../data/profile';
import StatsBar from './StatsBar.astro';
---
<section class="hero">
  <div class="hero-inner">
    <h1 class="hero-name">{profile.name}</h1>
    <div class="hero-badges">
      {profile.badges.map(badge => (
        <span class="badge">{badge}</span>
      ))}
    </div>
    <p class="hero-affiliation">{profile.affiliation} / {profile.lab}</p>
    <div class="hero-roles">
      {profile.roles.map(role => (
        <span class="role-tag">{role}</span>
      ))}
    </div>
    <p class="hero-bio">{profile.bio}</p>
    <div class="hero-cta">
      <a href="/achievements" class="btn btn-primary">実績を見る</a>
      <a href="/products" class="btn btn-outline">プロダクト</a>
    </div>
  </div>
  <StatsBar />
</section>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: var(--space-3xl) var(--space-md);
    overflow: hidden;
    isolation: isolate;
  }

  /* Aurora blobs */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
  }

  .hero::before {
    width: 480px;
    height: 480px;
    top: -180px;
    right: 8%;
    background: color-mix(in srgb, var(--color-primary) 16%, transparent);
    animation: heroFloat 14s ease-in-out infinite;
  }

  .hero::after {
    width: 400px;
    height: 400px;
    bottom: -140px;
    left: 5%;
    background: color-mix(in srgb, var(--color-accent) 13%, transparent);
    animation: heroFloat 18s ease-in-out infinite reverse;
  }

  @keyframes heroFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 20px) scale(1.08); }
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero-name {
    font-size: var(--text-hero);
    font-weight: 800;
    background: var(--gradient-brand);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: var(--space-sm) 0 var(--space-sm);
    letter-spacing: -0.03em;
    animation: heroGradient 8s ease infinite;
  }

  @keyframes heroGradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 14px;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: #fff;
    box-shadow: var(--shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .badge:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md), inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  /* 未踏アドバンスト */
  .badge:nth-child(1) {
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
  }

  /* Google AI アンバサダー */
  .badge:nth-child(2) {
    background: linear-gradient(135deg, #4285f4, #1d4ed8);
  }

  /* JPHACKS innovator */
  .badge:nth-child(3) {
    background: linear-gradient(135deg, #1e3a5f, #2d5a8e);
  }

  /* 100program メンター */
  .badge:nth-child(4) {
    background: linear-gradient(135deg, #ef4444, #7c3aed, #3b82f6);
  }

  .hero-affiliation {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  .hero-roles {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .role-tag {
    padding: var(--space-xs) var(--space-md);
    background-color: color-mix(in srgb, var(--color-surface) 70%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .role-tag:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    transform: translateY(-1px);
  }

  .hero-bio {
    max-width: 600px;
    margin: 0 auto var(--space-xl);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-accent), #ec4899);
    background-size: 150% 150%;
    color: #fff;
    box-shadow: 0 4px 14px -4px color-mix(in srgb, var(--color-accent) 55%, transparent);
  }

  .btn-primary:hover {
    background-position: 100% 50%;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -6px color-mix(in srgb, var(--color-accent) 65%, transparent);
    text-decoration: none;
  }

  .btn-outline {
    border: 2px solid var(--color-border);
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-surface) 70%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
</style>
