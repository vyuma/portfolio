---
import { getTier, type Tier } from '../data/tiers';

interface Props {
  tier: Tier;
}

const { tier } = Astro.props;
const m = getTier(tier);

/* SVG グラデーション ID の衝突を避けるためインスタンスごとに一意化 */
const uid = Math.random().toString(36).slice(2, 9);
const fillId = m.holographic ? `holo-${uid}` : `gem-${uid}`;

/* ブリリアントカットの宝石シルエット（viewBox 48x52） */
const SILHOUETTE = '16,7 32,7 42,21 24,47 6,21';
---
<div
  class:list={['tier-tag', { 'is-holo': m.holographic }]}
  data-tier={m.id}
  style={`--tier-accent:${m.accent};--tier-glow:${m.glow}`}
  role="img"
  aria-label={`TIER ${m.label}（${m.caption}）`}
  title={`${m.label} TIER ｜ ${m.caption}`}
>
  <svg class="gem" viewBox="0 0 48 52" width="22" height="24" aria-hidden="true">
    <defs>
      <linearGradient id={`gem-${uid}`} x1="0" y1="0" x2="0.3" y2="1">
        <stop offset="0" stop-color={m.gemHi} />
        <stop offset="1" stop-color={m.gemLo} />
      </linearGradient>
      {m.holographic && (
        <linearGradient id={`holo-${uid}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#7dd3fc" />
          <stop offset="0.28" stop-color="#a5b4fc" />
          <stop offset="0.52" stop-color="#f0abfc" />
          <stop offset="0.76" stop-color="#fcd34d" />
          <stop offset="1" stop-color="#6ee7b7" />
        </linearGradient>
      )}
    </defs>

    {/* base gem */}
    <polygon points={SILHOUETTE} fill={`url(#${fillId})`} />

    {/* facet shading — builds the cut-gem depth */}
    <polygon points="16,7 32,7 32,21 16,21" fill="#ffffff" opacity="0.40" />
    <polygon points="16,7 16,21 6,21" fill="#ffffff" opacity="0.18" />
    <polygon points="32,7 42,21 32,21" fill="#0b1220" opacity="0.12" />
    <polygon points="6,21 16,21 24,47" fill="#0b1220" opacity="0.06" />
    <polygon points="16,21 32,21 24,47" fill="#0b1220" opacity="0.14" />
    <polygon points="42,21 32,21 24,47" fill="#0b1220" opacity="0.26" />

    {/* facet edge lines */}
    <g stroke="#ffffff" stroke-width="1.1" opacity="0.5" fill="none" stroke-linejoin="round" stroke-linecap="round">
      <path d="M6 21 H42" />
      <path d="M16 7 V21 M32 7 V21" />
      <path d="M16 21 L24 47 M32 21 L24 47" />
    </g>

    {/* crisp outline */}
    <polygon points={SILHOUETTE} fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.6" stroke-linejoin="round" />
  </svg>

  <span class="tier-name">{m.label}</span>
</div>

<style>
  /* ===== Floating tag — sits on the card's top edge ===== */
  .tier-tag {
    position: absolute;
    top: -13px;
    right: 18px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 11px 4px 7px;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    box-shadow:
      0 0 0 1.2px color-mix(in srgb, var(--tier-accent) 50%, transparent),
      0 5px 14px -6px var(--tier-glow),
      0 1px 3px rgba(0, 0, 0, 0.12);
    pointer-events: none;
    user-select: none;
  }

  /* ===== The cut gem ===== */
  .gem {
    display: block;
    flex-shrink: 0;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.28));
  }

  .tier-tag.is-holo .gem {
    animation: gemHue 9s linear infinite;
  }

  @keyframes gemHue {
    to {
      filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.28)) hue-rotate(360deg);
    }
  }

  /* ===== Tier label ===== */
  .tier-name {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    line-height: 1;
    color: var(--tier-accent);
  }

  .tier-tag.is-holo .tier-name {
    background: linear-gradient(90deg, #38bdf8, #a78bfa, #f472b6, #38bdf8);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: nameFlow 6s linear infinite;
  }

  @keyframes nameFlow {
    to { background-position: 220% 0; }
  }

  /* ===== Responsive ===== */
  @media (max-width: 480px) {
    .tier-tag {
      top: -12px;
      right: 12px;
      padding: 3px 9px 3px 6px;
    }
    .tier-name {
      font-size: 0.55rem;
    }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .tier-tag.is-holo .gem,
    .tier-tag.is-holo .tier-name {
      animation: none;
    }
    .tier-tag.is-holo .tier-name {
      -webkit-text-fill-color: #38bdf8;
      color: #38bdf8;
    }
  }
</style>
