---
interface Props {
  text: string;
}

const { text } = Astro.props;
---
<span class="award-badge">{text}</span>

<style>
  .award-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: var(--space-xs) var(--space-sm);
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #78350f;
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: 999px;
    white-space: nowrap;
  }

  .award-badge::before {
    content: '🏆';
    font-size: 0.85em;
  }
</style>
