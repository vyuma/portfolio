---
import Social from './Social.astro';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">vyuma</span>
      <p class="footer-copy">&copy; {new Date().getFullYear()} vyuma. All rights reserved.</p>
    </div>
    <div class="footer-social">
      <Social platform="github" username="vyuma" />
      <Social platform="facebook" username="profile.php?id=61568847274162" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-3xl);
    padding: var(--space-xl) var(--space-md);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-logo {
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--color-accent);
  }

  .footer-copy {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-social {
    display: flex;
    gap: var(--space-md);
  }
</style>
