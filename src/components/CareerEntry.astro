---
import type { CareerEntry as CareerEntryType } from '../data/career';

interface Props {
  entry: CareerEntryType;
  isLast?: boolean;
}

const { entry, isLast = false } = Astro.props;

const categoryMap: Record<string, { label: string; className: string }> = {
  education: { label: '教育', className: 'cat-education' },
  role: { label: '役職', className: 'cat-role' },
  intern: { label: 'インターン', className: 'cat-intern' },
  award: { label: '受賞', className: 'cat-award' },
  certification: { label: '資格', className: 'cat-certification' },
};

const cat = categoryMap[entry.category] || categoryMap.education;

const dateStr = `${entry.startDate.getFullYear()}/${String(entry.startDate.getMonth() + 1).padStart(2, '0')}`;
---
<div class:list={['career-entry', { 'is-last': isLast }]}>
  <div class="timeline-dot-wrap">
    <div class:list={['timeline-dot', cat.className]}></div>
    {!isLast && <div class="timeline-line"></div>}
  </div>
  <div class="career-content">
    <div class="career-header">
      <span class:list={['career-badge', cat.className]}>{cat.label}</span>
      <time class="career-date">{dateStr}</time>
    </div>
    <h3 class="career-title">{entry.title}</h3>
    <p class="career-org">{entry.organization}</p>
    {entry.description && <p class="career-desc">{entry.description}</p>}
  </div>
</div>

<style>
  .career-entry {
    display: flex;
    gap: var(--space-lg);
    position: relative;
  }

  .timeline-dot-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 20px;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 3px solid var(--color-primary);
    background: var(--color-bg);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .timeline-dot.cat-education { border-color: var(--color-cat-education); }
  .timeline-dot.cat-role { border-color: var(--color-cat-role); }
  .timeline-dot.cat-intern { border-color: var(--color-cat-intern); }
  .timeline-dot.cat-award { border-color: var(--color-cat-award); }
  .timeline-dot.cat-certification { border-color: var(--color-cat-certification); }

  .timeline-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--color-border);
    min-height: 2rem;
  }

  .career-content {
    padding-bottom: var(--space-xl);
    flex: 1;
  }

  .is-last .career-content {
    padding-bottom: 0;
  }

  .career-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .career-badge {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: #fff;
    background-color: var(--color-primary);
  }

  .career-badge.cat-education { background-color: var(--color-cat-education); }
  .career-badge.cat-role { background-color: var(--color-cat-role); }
  .career-badge.cat-intern { background-color: var(--color-cat-intern); }
  .career-badge.cat-award { background-color: var(--color-cat-award); color: #78350f; }
  .career-badge.cat-certification { background-color: var(--color-cat-certification); }

  .career-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .career-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: var(--space-xs) 0;
  }

  .career-org {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-xs);
  }

  .career-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
  }
</style>
