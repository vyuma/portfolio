---
import type { Achievement } from '../data/achievements';

interface Props {
  achievement: Achievement;
  delay?: number;
}

const { achievement, delay = 0 } = Astro.props;

const hasAward = !!achievement.results;
const dateStr = `${achievement.date.getFullYear()}/${String(achievement.date.getMonth() + 1).padStart(2, '0')}`;

const tagColors: Record<string, string> = {
  hackathon: '#3b82f6',
  web: '#06b6d4',
  AI: '#8b5cf6',
  project: '#10b981',
  community: '#f97316',
  education: '#6366f1',
  learning: '#14b8a6',
  intern: '#a855f7',
  leadership: '#f59e0b',
  biology: '#22c55e',
  ideathon: '#ec4899',
  startup: '#f43f5e',
  lecture: '#0ea5e9',
  award: '#eab308',
};
---
<article
  class:list={['card', { 'card--awarded': hasAward }]}
  style={`--delay: ${delay}ms`}
>
  <div class="card-inner">
    {/* Meta row */}
    <div class="card-meta">
      <time class="card-date">{dateStr}</time>
      {achievement.tags.length > 0 && (
        <div class="card-tags">
          {achievement.tags.map(tag => (
            <span class="card-tag" style={`--tag-color: ${tagColors[tag] || '#64748b'}`}>{tag}</span>
          ))}
        </div>
      )}
    </div>

    {/* Title */}
    <h3 class="card-title">{achievement.title}</h3>

    {/* Description */}
    <p class="card-desc">{achievement.description}</p>

    {/* Links */}
    {achievement.urlDescription.length > 0 && (
      <div class="card-links">
        {achievement.urlDescription.map((label, index) => (
          <a href={achievement.url[index]} target="_blank" rel="noopener noreferrer" class="card-link">
            <svg class="card-link-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.5 3.5L11 8L6.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {label}
          </a>
        ))}
      </div>
    )}

    {/* Award */}
    {hasAward && (
      <div class="award">
        <div class="award-bg" />
        <div class="award-content">
          <div class="award-trophy">🏆</div>
          <div class="award-body">
            <span class="award-text">{achievement.results}</span>
          </div>
        </div>
        <div class="award-sparkle award-sparkle--1" />
        <div class="award-sparkle award-sparkle--2" />
        <div class="award-sparkle award-sparkle--3" />
      </div>
    )}
  </div>
</article>

<style>
  /* ========== Card ========== */
  .card {
    position: relative;
    width: 100%;
    max-width: 720px;
    box-sizing: border-box;
    border-radius: var(--radius-xl);
    background-color: color-mix(in srgb, var(--color-bg) 80%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-border);
    overflow: hidden;

    /* scroll animation */
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s ease var(--delay, 0ms),
      transform 0.5s ease var(--delay, 0ms),
      box-shadow var(--transition-base),
      border-color var(--transition-base);
  }

  .card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .card.is-visible:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
    box-shadow: var(--shadow-lg);
  }

  /* Awarded card glow */
  .card--awarded {
    border-color: rgba(251, 191, 36, 0.35);
    box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.08);
  }

  .card--awarded.is-visible:hover {
    border-color: rgba(251, 191, 36, 0.6);
    box-shadow: 0 8px 24px -4px rgba(251, 191, 36, 0.15), var(--shadow-lg);
  }

  /* ========== Inner ========== */
  .card-inner {
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* ========== Meta ========== */
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .card-date {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .card-tag {
    display: inline-block;
    padding: 1px 8px;
    border-radius: var(--radius-full);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--tag-color);
    background-color: color-mix(in srgb, var(--tag-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 20%, transparent);
    text-transform: uppercase;
  }

  /* ========== Title ========== */
  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  /* ========== Description ========== */
  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
    max-width: none;
  }

  /* ========== Links ========== */
  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px 12px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .card-link:hover {
    background-color: var(--color-primary);
    color: #fff;
    text-decoration: none;
    border-color: var(--color-primary);
  }

  .card-link-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  /* ==============================================
     AWARD - Pop & Vibrant
     ============================================== */
  .award {
    position: relative;
    margin-top: var(--space-md);
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  /* Colorful gradient background */
  .award-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, #fbbf24 0%, #f59e0b 25%, #f97316 50%, #fbbf24 75%, #eab308 100%);
    background-size: 300% 300%;
    animation: awardGradient 6s ease infinite;
    z-index: 0;
  }

  @keyframes awardGradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .award-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
  }

  /* Trophy */
  .award-trophy {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
    animation: trophyBounce 2s ease-in-out infinite;
  }

  @keyframes trophyBounce {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-3px) scale(1.05); }
  }

  .award-body {
    flex: 1;
    min-width: 0;
  }

  .award-text {
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: var(--leading-snug);
    color: #1c1917;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  /* Sparkle particles */
  .award-sparkle {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: #fff;
    opacity: 0;
    z-index: 3;
    animation: sparkle 3s ease-in-out infinite;
    pointer-events: none;
  }

  .award-sparkle--1 {
    top: 20%;
    right: 12%;
    animation-delay: 0s;
  }

  .award-sparkle--2 {
    top: 60%;
    right: 25%;
    animation-delay: 1s;
    width: 4px;
    height: 4px;
  }

  .award-sparkle--3 {
    top: 30%;
    right: 40%;
    animation-delay: 2s;
    width: 5px;
    height: 5px;
  }

  @keyframes sparkle {
    0%, 100% { opacity: 0; transform: scale(0); }
    50% { opacity: 0.9; transform: scale(1); }
  }

  /* ========== Responsive ========== */
  @media (max-width: 480px) {
    .card-inner {
      padding: var(--space-md);
    }

    .award-content {
      padding: var(--space-sm) var(--space-md);
      gap: var(--space-sm);
    }

    .award-trophy {
      font-size: 1.5rem;
    }
  }
</style>
