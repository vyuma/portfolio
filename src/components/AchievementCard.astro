---
import type { Achievement } from '../data/achievements';
import { getTier } from '../data/tiers';
import TierBadge from './TierBadge.astro';

interface Props {
  achievement: Achievement;
  delay?: number;
}

const { achievement, delay = 0 } = Astro.props;

const hasAward = !!achievement.results;
const dateStr = `${achievement.date.getFullYear()}/${String(achievement.date.getMonth() + 1).padStart(2, '0')}`;
const tier = getTier(achievement.tier);

const tagColors: Record<string, string> = {
  hackathon: '#3b82f6',
  web: '#06b6d4',
  AI: '#8b5cf6',
  project: '#10b981',
  community: '#f97316',
  education: '#6366f1',
  learning: '#14b8a6',
  intern: '#a855f7',
  leadership: '#f59e0b',
  biology: '#22c55e',
  ideathon: '#ec4899',
  startup: '#f43f5e',
  lecture: '#0ea5e9',
  award: '#eab308',
};
---
<article
  class="card"
  data-tier={tier.id}
  style={`--delay: ${delay}ms; --tier-grad: ${tier.gradient}; --tier-accent: ${tier.accent}; --tier-glow: ${tier.glow}; --tier-text: ${tier.text}; --tier-text-shadow: ${tier.textShadow}`}
>
  {/* TIER tag — refined gem, rests on the top edge */}
  <TierBadge tier={achievement.tier} />

  <div class="card-inner">
    {/* Meta row */}
    <div class="card-meta">
      <time class="card-date">{dateStr}</time>
      {achievement.tags.length > 0 && (
        <div class="card-tags">
          {achievement.tags.map(tag => (
            <span class="card-tag" style={`--tag-color: ${tagColors[tag] || '#64748b'}`}>{tag}</span>
          ))}
        </div>
      )}
    </div>

    {/* Title */}
    <h3 class="card-title">{achievement.title}</h3>

    {/* Description */}
    <p class="card-desc">{achievement.description}</p>

    {/* Links */}
    {achievement.urlDescription.length > 0 && (
      <div class="card-links">
        {achievement.urlDescription.map((label, index) => (
          <a href={achievement.url[index]} target="_blank" rel="noopener noreferrer" class="card-link">
            <svg class="card-link-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.5 3.5L11 8L6.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {label}
          </a>
        ))}
      </div>
    )}

    {/* Result — TIER-colored banner, no emoji */}
    {hasAward && (
      <div class="award">
        <div class="award-inner">
          <span class="award-tier">{tier.label}</span>
          <p class="award-text">{achievement.results}</p>
        </div>
      </div>
    )}
  </div>
</article>

<style>
  /* ========== Card ========== */
  .card {
    position: relative;
    width: 100%;
    max-width: 720px;
    box-sizing: border-box;
    border-radius: var(--radius-xl);
    background-color: var(--color-bg);

    /* scroll-in animation */
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.55s ease var(--delay, 0ms),
      transform 0.55s ease var(--delay, 0ms),
      box-shadow var(--transition-base);
  }

  /* TIER gradient frame (the colored 枠) — thin & refined */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1.5px;
    background: var(--tier-grad);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  .card.is-visible {
    opacity: 1;
    transform: translateY(0);
    box-shadow: var(--shadow-sm);
  }

  .card.is-visible:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -12px var(--tier-glow), var(--shadow-lg);
  }

  /* Diamond — the only tier with motion: a slow holographic frame + soft glow */
  .card[data-tier='diamond']::after {
    padding: 2px;
    background-size: 220% 220%;
    animation: frameFlow 7s ease infinite;
  }

  .card[data-tier='diamond'].is-visible {
    box-shadow: 0 6px 22px -10px var(--tier-glow);
  }

  .card[data-tier='diamond'].is-visible:hover {
    box-shadow: 0 16px 36px -10px var(--tier-glow), var(--shadow-lg);
  }

  @keyframes frameFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ========== Inner ========== */
  .card-inner {
    position: relative;
    z-index: 1;
    padding: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* ========== Meta ========== */
  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .card-date {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .card-tag {
    display: inline-block;
    padding: 1px 8px;
    border-radius: var(--radius-full);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--tag-color);
    background-color: color-mix(in srgb, var(--tag-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag-color) 20%, transparent);
    text-transform: uppercase;
  }

  /* ========== Title ========== */
  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0;
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  /* ========== Description ========== */
  .card-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: var(--leading-normal);
    max-width: none;
  }

  /* ========== Links ========== */
  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-xs);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px 12px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .card-link:hover {
    background-color: var(--color-primary);
    color: #fff;
    text-decoration: none;
    border-color: var(--color-primary);
  }

  .card-link-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
  }

  /* ==============================================
     RESULT — TIER-colored banner (no emoji)
     ============================================== */
  .award {
    position: relative;
    margin-top: var(--space-md);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--tier-grad);
    background-size: 240% 240%;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.28),
      0 6px 18px -10px var(--tier-glow);
  }

  /* glassy sheen for depth */
  .award::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.34) 0%,
      rgba(255, 255, 255, 0) 46%,
      rgba(0, 0, 0, 0.07) 100%
    );
    pointer-events: none;
  }

  .award-inner {
    position: relative;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  /* small eyebrow showing the TIER */
  .award-tier {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: var(--tier-text);
    opacity: 0.62;
  }

  .award-text {
    margin: 0;
    max-width: none;
    font-size: var(--text-sm);
    font-weight: 800;
    line-height: var(--leading-snug);
    color: var(--tier-text);
    text-shadow: var(--tier-text-shadow);
  }

  /* Diamond — gently drifting holographic banner */
  .card[data-tier='diamond'] .award {
    animation: awardFlow 9s ease infinite;
  }

  @keyframes awardFlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* ========== Responsive ========== */
  @media (max-width: 480px) {
    .card-inner {
      padding: var(--space-md);
    }

    .award-inner {
      padding: var(--space-sm) var(--space-md);
    }
  }

  /* ========== Reduced motion ========== */
  @media (prefers-reduced-motion: reduce) {
    .card[data-tier='diamond']::after,
    .card[data-tier='diamond'] .award {
      animation: none;
    }
  }
</style>
