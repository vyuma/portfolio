---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BlogPost from '../components/BlogPost.astro';

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true })) as any[];
---
<BaseLayout pageTitle="Blog - vyuma" fullWidth>
  <PageHero title="Blog" subtitle="ブログ記事" />
  <div class="container">
    <ul class="post-list">
      {allPosts.map((post) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
    </ul>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md) var(--space-3xl);
  }

  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .post-list :global(li) {
    padding: var(--space-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .post-list :global(li:hover) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .post-list :global(a) {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
  }
</style>
