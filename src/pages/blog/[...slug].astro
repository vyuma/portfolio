---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // posts is newest-first: prev = older, next = newer
      prev: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
// 日本語の読了目安: 約500文字/分
const readingMinutes = Math.max(1, Math.round((post.body ?? '').length / 500));
---
<BaseLayout pageTitle={`${post.data.title} - vyuma`} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <a href="/blog" class="back-link">← Blog</a>
      <div class="post-meta">
        <time datetime={d.toISOString()}>{dateStr}</time>
        <span class="meta-sep">·</span>
        <span>{readingMinutes} min read</span>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map(tag => (
            <a href={`/tags/${tag}`} class="post-tag">#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      {prev ? (
        <a href={`/blog/${prev.id}/`} class="pager pager-prev">
          <span class="pager-label">← 前の記事</span>
          <span class="pager-title">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/blog/${next.id}/`} class="pager pager-next">
          <span class="pager-label">次の記事 →</span>
          <span class="pager-title">{next.data.title}</span>
        </a>
      ) : <span />}
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-2xl) 0 var(--space-3xl);
  }

  /* ===== Header ===== */
  .post-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-text-light);
    margin-bottom: var(--space-lg);
  }

  .back-link:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-sm);
  }

  .meta-sep {
    color: var(--color-border);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-sm);
  }

  .post-desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-md);
  }

  .post-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .post-tag:hover {
    color: var(--color-primary);
    text-decoration: none;
  }

  /* ===== Prose ===== */
  .prose {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: var(--space-2xl) 0 var(--space-md);
    padding-top: var(--space-md);
  }

  .prose :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: var(--space-xl) 0 var(--space-sm);
  }

  .prose :global(p) {
    margin: 0 0 var(--space-md);
    max-width: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-md);
    padding-left: 1.4em;
  }

  .prose :global(li) {
    margin-bottom: var(--space-xs);
  }

  .prose :global(strong) {
    font-weight: 700;
  }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-primary);
  }

  .prose :global(img) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin: var(--space-lg) 0;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-xl) 0;
  }

  /* ===== Footer pager ===== */
  .post-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .pager {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
    min-width: 0;
  }

  .pager:hover {
    background-color: var(--color-surface);
    border-color: color-mix(in srgb, var(--color-text) 25%, var(--color-border));
    text-decoration: none;
  }

  .pager-next {
    text-align: right;
  }

  .pager-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    letter-spacing: 0.04em;
  }

  .pager-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .post-footer {
      grid-template-columns: 1fr;
    }

    .pager-next {
      text-align: left;
    }
  }
</style>
