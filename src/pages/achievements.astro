---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AchievementList from '../components/AchievementList.astro';
import { achievements } from '../data/achievements';

const totalCount = achievements.length;
const awardCount = achievements.filter(a => a.results).length;
const yearSpan = `${Math.min(...achievements.map(a => a.date.getFullYear()))}–${Math.max(...achievements.map(a => a.date.getFullYear()))}`;
---
<BaseLayout pageTitle="Achievements - vyuma" fullWidth>
  <PageHero title="Achievements" subtitle="参加実績" />

  <div class="page-container">
    {/* Summary */}
    <div class="summary-bar">
      <div class="summary-inner">
        <div class="summary-pill">
          <span class="summary-value">{totalCount}</span>
          <span class="summary-label">イベント</span>
        </div>
        <div class="summary-dot" />
        <div class="summary-pill">
          <span class="summary-value">{awardCount}</span>
          <span class="summary-label">受賞</span>
        </div>
        <div class="summary-dot" />
        <div class="summary-pill">
          <span class="summary-value">{yearSpan}</span>
          <span class="summary-label">活動期間</span>
        </div>
      </div>
    </div>

    <AchievementList />
  </div>
</BaseLayout>

<style>
  .page-container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--space-md) var(--space-3xl);
  }

  /* ===== Summary ===== */
  .summary-bar {
    margin: 0 auto var(--space-xl);
  }

  .summary-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .summary-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .summary-value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .summary-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .summary-dot {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background-color: var(--color-border);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .summary-inner {
      gap: var(--space-md);
      padding: var(--space-sm) var(--space-md);
    }

    .summary-value {
      font-size: var(--text-lg);
    }
  }
</style>
